      "type": "number",
      "description": "Blank cost"
    },
    "print_cost": {
      "type": "number",
      "description": "Print cost"
    },
    "labor_cost": {
      "type": "number",
      "description": "Labor cost"
    },
    "packaging_cost": {
      "type": "number",
      "description": "Packaging cost"
    },
    "target_retail_price": {
      "type": "number",
      "description": "Target retail price"
    },
    "expected_monthly_volume": {
      "type": "number",
