{
  "name": "AletheaProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "client_id": {
      "type": "string",
      "description": "Linked client"
    },
    "linked_project_id": {
      "type": "string",
      "description": "Linked to main project entity"
    },
    "business_model": {
      "type": "string",
      "enum": [
        "ecommerce",
        "non_ecommerce",
        "hybrid"
      ],
      "description": "Business model"
    },
    "package_type": {
      "type": "string",
      "enum": [
        "strategy",
        "content_week",
        "website",
        "full_os",
        "custom"
      ],
      "description": "Package type"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "on_hold",
        "completed"
      ],
      "default": "draft",
      "description": "Project status"
    },
    "current_phase_id": {
      "type": "string",
      "description": "Current active phase"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Overall progress"
    },
    "selected_platform": {
      "type": "string",
      "enum": [
        "not_selected",
        "meta",
        "tiktok",
        "both"
      ],
      "default": "not_selected",
      "description": "Selected platform"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date"
    },
    "estimated_completion": {
      "type": "string",
      "format": "date",
      "description": "Estimated completion"
    },
    "total_project_value": {
      "type": "number",
      "description": "Total project value"
    },
    "client_portal_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Client portal enabled"
    },
    "primary_persona_id": {
      "type": "string",
      "description": "Primary customer profile"
    },
    "generated_positioning_statement": {
      "type": "string",
      "description": "AI generated positioning"
    },
    "generated_messaging_angles": {
      "type": "string",
      "description": "AI generated messaging"
    },
    "generated_ad_hooks": {
      "type": "string",
      "description": "AI generated ad hooks"
    },
    "generated_product_copy": {
      "type": "string",
      "description": "AI generated product copy"
    },
    "strategy_intake_completed": {
      "type": "boolean",
      "default": false
    },
    "identity_intake_completed": {
      "type": "boolean",
      "default": false
    },
    "website_intake_completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "client_id"
  ]
}