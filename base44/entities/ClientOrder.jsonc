{
  "name": "ClientOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "tracking_code": {
      "type": "string",
      "description": "Client tracking code"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "catalog_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "print_options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                }
              }
            }
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "converted"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string",
      "description": "Client special instructions"
    },
    "design_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "client_name",
    "client_phone"
  ]
}